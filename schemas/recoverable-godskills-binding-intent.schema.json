{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": { "digest": { "type": "string", "minLength": 64, "maxLength": 64 } },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolId", "missionId", "releaseDigest", "input", "inputDigest", "intentDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-recoverable-godskills-binding-intent-v1" },
    "missionId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "releaseDigest": { "$ref": "#/$defs/digest" },
    "input": { "type": "object" },
    "inputDigest": { "$ref": "#/$defs/digest" },
    "intentDigest": { "$ref": "#/$defs/digest" }
  }
}
