{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "buildId", "candidateDigest", "policyDigest", "expressionDigest", "moduleManifestDigest", "genomeDigest", "derivedAttributes", "artifacts", "validations", "omittedComponents"],
  "properties": {
    "schemaVersion": { "const": 1 }, "artifactId": { "$ref": "#/$defs/identifier" }, "buildId": { "$ref": "#/$defs/digest" },
    "candidateDigest": { "$ref": "#/$defs/digest" }, "policyDigest": { "$ref": "#/$defs/digest" }, "expressionDigest": { "$ref": "#/$defs/digest" },
    "moduleManifestDigest": { "$ref": "#/$defs/digest" }, "genomeDigest": { "$ref": "#/$defs/digest" },
    "derivedAttributes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 } },
    "artifacts": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256", "trustClass"],
        "properties": {
          "path": { "$ref": "#/$defs/identifier" }, "sha256": { "$ref": "#/$defs/digest" },
          "trustClass": { "enum": ["presentation-only", "creation-input", "trusted-ceiling", "operational-projection"] }
        }
      }
    },
    "validations": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "omittedComponents": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
  }
}
