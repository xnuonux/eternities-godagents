{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolId", "executableReceipt", "entrypoint"],
  "properties": {
    "protocolId": { "const": "eternities-godskills-routing-executable-v1" },
    "executableReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "receiptDigest"],
      "properties": {
        "path": { "const": "receipts/routing-executable-v1.json" },
        "sha256": { "$ref": "#/$defs/digest" },
        "receiptDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "scripts/routing.mjs" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
