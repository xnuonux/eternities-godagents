{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "missionId", "leadInstanceId", "sourceEpoch", "authority", "excerpts", "assignments", "budget"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "missionId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "leadInstanceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sourceEpoch": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "authority": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["observe", "propose", "analyze"] }
    },
    "excerpts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceRef", "provenance", "content"],
        "properties": {
          "sourceRef": { "type": "string", "minLength": 1, "maxLength": 256 },
          "provenance": { "type": "string", "minLength": 1, "maxLength": 128 },
          "content": { "type": "string", "minLength": 1, "maxLength": 8192 }
        }
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workerId", "role", "maxCompletionTokens"],
        "properties": {
          "workerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "role": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" },
          "maxCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 100000 }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxCompletionTokens", "maxResultBytes"],
      "properties": {
        "maxCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxResultBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 }
      }
    }
  }
}
