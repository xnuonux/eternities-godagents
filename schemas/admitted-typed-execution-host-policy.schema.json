{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "strings": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "runtime", "realmId", "authority", "hostContext"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolId", "instanceId", "distributionDir", "journalPath", "snapshotPath", "hostAdapterId", "revocationEpoch", "godskillsRelease", "routingExecutable", "typedCompositionRelease", "typedExecutionStepperRelease", "activationClassifier", "executors", "limits"],
      "properties": {
        "protocolId": { "const": "eternities-admitted-sealed-typed-execution-host-v1" },
        "instanceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "distributionDir": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "journalPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "snapshotPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "hostAdapterId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revocationEpoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "godskillsRelease": { "type": "object" },
        "routingExecutable": { "type": "object" },
        "typedCompositionRelease": { "type": "object" },
        "typedExecutionStepperRelease": { "type": "object" },
        "activationClassifier": { "type": "object" },
        "executors": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "object" } },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeoutMs", "maximumGodskillsDispatchBytes", "maximumGodskillsCompletionBytes", "maximumGodskillsResultBytes", "maximumExecutorInputBytes", "maximumExecutorOutputBytes", "maximumMissionInputBytes", "maximumTopologyNodes", "maximumTopologyLinks", "maxArtifactBytes", "nativeCompletionTokens", "reviewCompletionTokensPerRound", "revisionCompletionTokens", "totalCompletionTokens", "maxProjectionBytes", "maxCycles"],
          "properties": {
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
            "maximumGodskillsDispatchBytes": { "type": "integer", "minimum": 256, "maximum": 16777216 },
            "maximumGodskillsCompletionBytes": { "type": "integer", "minimum": 256, "maximum": 16777216 },
            "maximumGodskillsResultBytes": { "type": "integer", "minimum": 256, "maximum": 16777216 },
            "maximumExecutorInputBytes": { "type": "integer", "minimum": 256, "maximum": 16777216 },
            "maximumExecutorOutputBytes": { "type": "integer", "minimum": 256, "maximum": 16777216 },
            "maximumMissionInputBytes": { "type": "integer", "minimum": 256, "maximum": 16777216 },
            "maximumTopologyNodes": { "type": "integer", "minimum": 1, "maximum": 3 },
            "maximumTopologyLinks": { "type": "integer", "minimum": 0, "maximum": 64 },
            "maxArtifactBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
            "nativeCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "reviewCompletionTokensPerRound": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "revisionCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "totalCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "maxProjectionBytes": { "type": "integer", "minimum": 256, "maximum": 1048576 },
            "maxCycles": { "type": "integer", "minimum": 1, "maximum": 32 }
          }
        }
      }
    },
    "realmId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "authority": { "$ref": "#/$defs/strings" },
    "hostContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permittedEffects", "availableAuthority", "availablePreconditions", "forbiddenCapabilities", "maximumRisk", "minimumEvidenceConfidence", "contextBudget", "maxCompositionSize"],
      "properties": {
        "permittedEffects": { "$ref": "#/$defs/strings" },
        "availableAuthority": { "$ref": "#/$defs/strings" },
        "availablePreconditions": { "$ref": "#/$defs/strings" },
        "forbiddenCapabilities": { "$ref": "#/$defs/strings" },
        "maximumRisk": { "enum": ["low", "moderate", "high"] },
        "minimumEvidenceConfidence": { "enum": ["unverified", "inferred", "verified"] },
        "contextBudget": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxCompositionSize": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    }
  }
}
