{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "strings": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "runtime", "realmId", "authority", "hostContext"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "policyId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolId", "instanceId", "distributionDir", "journalPath", "snapshotPath", "hostAdapterId", "revocationEpoch", "effectOnlyRepositoryRoot", "routingExecutable", "verifierExecutable", "nativeTransport", "limits", "effectProducerDescriptorDigest"],
      "properties": {
        "protocolId": { "const": "eternities-admitted-sealed-identity-host-v2" },
        "effectProducerDescriptorDigest": { "type": "string", "minLength": 64, "maxLength": 64 },
        "instanceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "distributionDir": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "journalPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "snapshotPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "hostAdapterId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revocationEpoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "effectOnlyRepositoryRoot": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "routingExecutable": { "type": "object" },
        "verifierExecutable": { "type": "object" },
        "nativeTransport": { "type": "object" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeoutMs", "maximumNativeMaterializedBytes", "maxArtifactBytes", "nativeCompletionTokens", "reviewCompletionTokensPerRound", "revisionCompletionTokens", "totalCompletionTokens", "maxProjectionBytes", "maxCycles"],
          "properties": {
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
            "maximumNativeMaterializedBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 },
            "maxArtifactBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
            "nativeCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "reviewCompletionTokensPerRound": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "revisionCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "totalCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "maxProjectionBytes": { "type": "integer", "minimum": 256, "maximum": 1048576 },
            "maxCycles": { "type": "integer", "minimum": 1, "maximum": 32 }
          }
        }
      }
    },
    "realmId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "authority": { "$ref": "#/$defs/strings" },
    "hostContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permittedEffects", "availableAuthority", "availablePreconditions", "forbiddenCapabilities", "maximumRisk", "minimumEvidenceConfidence", "contextBudget", "maxCompositionSize"],
      "properties": {
        "permittedEffects": { "$ref": "#/$defs/strings" },
        "availableAuthority": { "$ref": "#/$defs/strings" },
        "availablePreconditions": { "$ref": "#/$defs/strings" },
        "forbiddenCapabilities": { "$ref": "#/$defs/strings" },
        "maximumRisk": { "enum": ["low", "moderate", "high"] },
        "minimumEvidenceConfidence": { "enum": ["unverified", "inferred", "verified"] },
        "contextBudget": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxCompositionSize": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    }
  }
}
