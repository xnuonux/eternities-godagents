{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolId", "status", "active", "bindingId", "bindingCandidateId", "bindingCandidateDigest", "identityDigest", "instanceId", "genesisId", "genomeDigest", "distributionDigest", "realmContractDigest", "keelId", "keelHeadDigest", "taskId", "hostAdapterId", "revocationEpoch", "createdAt", "lastVerifiedAt", "lease", "authority", "registryEventDigest", "receiptDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-godagent-cortex-binding-registry-v1" },
    "status": { "const": "active" },
    "active": { "const": true },
    "bindingId": { "$ref": "#/$defs/digest" },
    "bindingCandidateId": { "$ref": "#/$defs/digest" },
    "bindingCandidateDigest": { "$ref": "#/$defs/digest" },
    "identityDigest": { "$ref": "#/$defs/digest" },
    "instanceId": { "$ref": "#/$defs/identifier" },
    "genesisId": { "$ref": "#/$defs/digest" },
    "genomeDigest": { "$ref": "#/$defs/digest" },
    "distributionDigest": { "$ref": "#/$defs/digest" },
    "realmContractDigest": { "$ref": "#/$defs/digest" },
    "keelId": { "type": "string", "minLength": 69, "maxLength": 69 },
    "keelHeadDigest": { "$ref": "#/$defs/digest" },
    "taskId": { "$ref": "#/$defs/identifier" },
    "hostAdapterId": { "$ref": "#/$defs/identifier" },
    "revocationEpoch": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "minLength": 20, "maxLength": 32 },
    "lastVerifiedAt": { "type": "string", "minLength": 20, "maxLength": 32 },
    "lease": {
      "type": "object", "additionalProperties": false, "required": ["leaseId", "mode", "issuedAt", "expiresAt"],
      "properties": {
        "leaseId": { "$ref": "#/$defs/digest" }, "mode": { "const": "exclusive-writer" },
        "issuedAt": { "type": "string", "minLength": 20, "maxLength": 32 },
        "expiresAt": { "type": "string", "minLength": 20, "maxLength": 32 }
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false, "required": ["continuity", "realmEffects"],
      "properties": { "continuity": { "const": "host-lease-only" }, "realmEffects": { "const": "none" } }
    },
    "registryEventDigest": { "$ref": "#/$defs/digest" },
    "receiptDigest": { "$ref": "#/$defs/digest" }
  }
}
