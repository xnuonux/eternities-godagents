{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolId", "status", "modelStarted", "operationId", "requestDigest", "transportDescriptorDigest", "task", "instructionChannel", "parentReceiptDigest", "reasonDigest", "receiptDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-codex-task-control-v1" },
    "status": { "enum": ["reserved", "cancelled"] },
    "modelStarted": { "const": false },
    "operationId": { "$ref": "#/$defs/identifier" },
    "requestDigest": { "$ref": "#/$defs/digest" },
    "transportDescriptorDigest": { "$ref": "#/$defs/digest" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "hostId"],
      "properties": {
        "taskId": { "$ref": "#/$defs/identifier" },
        "hostId": { "$ref": "#/$defs/identifier" }
      }
    },
    "instructionChannel": { "enum": ["developer", "sealed-user-envelope"] },
    "parentReceiptDigest": { "$ref": "#/$defs/digest" },
    "reasonDigest": { "$ref": "#/$defs/digest" },
    "receiptDigest": { "$ref": "#/$defs/digest" }
  }
}
