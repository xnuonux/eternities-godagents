{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryField", "compensatingField"],
      "properties": {
        "primaryField": { "type": "string", "minLength": 1, "maxLength": 128 },
        "compensatingField": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "protocolId", "contractDigest", "primaryHandId",
    "compensatingHandId", "payloadBindings", "outputBindings", "relationDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-realm-compensation-relation-v1" },
    "contractDigest": { "$ref": "#/$defs/digest" },
    "primaryHandId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "compensatingHandId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "payloadBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/binding" }
    },
    "outputBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/binding" }
    },
    "relationDigest": { "$ref": "#/$defs/digest" }
  }
}
