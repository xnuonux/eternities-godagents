{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": { "digest": { "type": "string", "minLength": 64, "maxLength": 64 } },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolId", "transactionId", "missionSlotId", "events", "headDigest", "stateDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-mission-review-journal-v1" },
    "transactionId": { "$ref": "#/$defs/digest" },
    "missionSlotId": { "$ref": "#/$defs/digest" },
    "events": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "object" } },
    "headDigest": { "$ref": "#/$defs/digest" },
    "stateDigest": { "$ref": "#/$defs/digest" }
  }
}
