{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "missionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["realmEffects", "continuityWrites", "identityMutation", "evolution", "soul"],
      "properties": {
        "realmEffects": { "const": 0 },
        "continuityWrites": { "const": 0 },
        "identityMutation": { "const": 0 },
        "evolution": { "const": 0 },
        "soul": { "const": 0 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "protocolId", "operationKind", "sourceDescriptorDigest",
    "missionStepDescriptorDigest", "programId", "stepId", "stepIndex", "inputDigest",
    "dispatchId", "dispatchDigest", "authorityCeilingDigest", "maxCompletionTokens",
    "maxResultBytes", "authority", "requestDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-mission-operation-request-v1" },
    "operationKind": { "$ref": "#/$defs/identifier" },
    "sourceDescriptorDigest": { "$ref": "#/$defs/digest" },
    "missionStepDescriptorDigest": { "$ref": "#/$defs/digest" },
    "programId": { "$ref": "#/$defs/digest" },
    "stepId": { "$ref": "#/$defs/identifier" },
    "stepIndex": { "type": "integer", "minimum": 0, "maximum": 7 },
    "inputDigest": { "$ref": "#/$defs/digest" },
    "dispatchId": { "$ref": "#/$defs/digest" },
    "dispatchDigest": { "$ref": "#/$defs/digest" },
    "authorityCeilingDigest": { "$ref": "#/$defs/digest" },
    "maxCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 4000000 },
    "maxResultBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "authority": { "$ref": "#/$defs/missionAuthority" },
    "requestDigest": { "$ref": "#/$defs/digest" }
  }
}
