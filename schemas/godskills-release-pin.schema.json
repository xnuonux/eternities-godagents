{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapterProtocol", "repositoryRoot", "systemReceipt", "routerReceipt", "compilerReceipt", "portableReceipt", "portableManifest", "semanticEffectBindings", "maximumSelected", "maximumPackageBytes"],
  "properties": {
    "adapterProtocol": { "const": "eternities-godskills-adapter-v1" },
    "repositoryRoot": { "type": "string", "minLength": 1 },
    "systemReceipt": { "$ref": "#/$defs/artifact" },
    "routerReceipt": { "$ref": "#/$defs/artifact" },
    "compilerReceipt": { "$ref": "#/$defs/artifact" },
    "portableReceipt": { "$ref": "#/$defs/artifact" },
    "portableManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "manifestDigest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "manifestDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "activation": { "$ref": "#/$defs/activation" },
    "semanticEffectBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write"],
      "properties": {
        "read": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "write": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "maximumSelected": { "type": "integer", "minimum": 1, "maximum": 3 },
    "maximumPackageBytes": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "receiptArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "receiptDigest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "receiptDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "logicalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "logicalDigest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "logicalDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolId", "executableReceipt", "parentReceipt", "entrypoint", "compiler", "dependencies", "schemas", "policy", "evidence", "contract"],
      "properties": {
        "protocolId": { "const": "eternities-godskills-activation-v1" },
        "executableReceipt": { "$ref": "#/$defs/receiptArtifact" },
        "parentReceipt": { "$ref": "#/$defs/receiptArtifact" },
        "entrypoint": { "$ref": "#/$defs/artifact" },
        "compiler": { "$ref": "#/$defs/artifact" },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "schemas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request", "result"],
          "properties": {
            "request": { "$ref": "#/$defs/artifact" },
            "result": { "$ref": "#/$defs/artifact" }
          }
        },
        "policy": { "$ref": "#/$defs/logicalArtifact" },
        "evidence": { "$ref": "#/$defs/logicalArtifact" },
        "contract": { "$ref": "#/$defs/artifact" }
      }
    }
  }
}
