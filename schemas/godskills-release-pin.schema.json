{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapterProtocol", "repositoryRoot", "systemReceipt", "routerReceipt", "compilerReceipt", "portableReceipt", "portableManifest", "semanticEffectBindings", "maximumSelected", "maximumPackageBytes"],
  "properties": {
    "adapterProtocol": { "const": "eternities-godskills-adapter-v1" },
    "repositoryRoot": { "type": "string", "minLength": 1 },
    "systemReceipt": { "$ref": "#/$defs/artifact" },
    "routerReceipt": { "$ref": "#/$defs/artifact" },
    "compilerReceipt": { "$ref": "#/$defs/artifact" },
    "portableReceipt": { "$ref": "#/$defs/artifact" },
    "portableManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "manifestDigest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "manifestDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "semanticEffectBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write"],
      "properties": {
        "read": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "write": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "maximumSelected": { "type": "integer", "minimum": 1, "maximum": 3 },
    "maximumPackageBytes": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
