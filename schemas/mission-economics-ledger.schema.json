{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "nonNegative": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase", "round", "requestDigest", "executorDescriptorDigest", "resultDigest", "cacheKeyDigest",
        "inputTokens", "cachedInputTokens", "uncachedInputTokens", "reasoningTokens", "visibleOutputTokens",
        "completionTokens", "completionBudgetTokens", "completionHeadroomTokens", "completionUtilizationBps",
        "cacheCoverageBps", "startedAt", "completedAt", "latencyMs"
      ],
      "properties": {
        "phase": { "enum": ["native", "review", "revision"] },
        "round": { "type": "integer", "minimum": 1, "maximum": 2 },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "executorDescriptorDigest": { "$ref": "#/$defs/digest" },
        "resultDigest": { "$ref": "#/$defs/digest" },
        "cacheKeyDigest": { "$ref": "#/$defs/digest" },
        "inputTokens": { "$ref": "#/$defs/nonNegative" },
        "cachedInputTokens": { "$ref": "#/$defs/nonNegative" },
        "uncachedInputTokens": { "$ref": "#/$defs/nonNegative" },
        "reasoningTokens": { "$ref": "#/$defs/nonNegative" },
        "visibleOutputTokens": { "$ref": "#/$defs/nonNegative" },
        "completionTokens": { "$ref": "#/$defs/nonNegative" },
        "completionBudgetTokens": { "$ref": "#/$defs/nonNegative" },
        "completionHeadroomTokens": { "$ref": "#/$defs/nonNegative" },
        "completionUtilizationBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "cacheCoverageBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "startedAt": { "type": "string", "minLength": 24, "maxLength": 24 },
        "completedAt": { "type": "string", "minLength": 24, "maxLength": 24 },
        "latencyMs": { "$ref": "#/$defs/nonNegative" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "protocolId", "missionId", "admissionDigest", "completionReceiptDigest", "phases",
    "totals", "proofLimits", "ledgerDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-mission-economics-ledger-v1" },
    "missionId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "admissionDigest": { "$ref": "#/$defs/digest" },
    "completionReceiptDigest": { "$ref": "#/$defs/digest" },
    "phases": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/phase" } },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phaseCount", "inputTokens", "cachedInputTokens", "uncachedInputTokens", "reasoningTokens",
        "visibleOutputTokens", "completionTokens", "completionBudgetTokens", "completionHeadroomTokens",
        "completionUtilizationBps", "cacheCoverageBps", "sumPhaseLatencyMs", "elapsedLatencyMs"
      ],
      "properties": {
        "phaseCount": { "type": "integer", "minimum": 1, "maximum": 4 },
        "inputTokens": { "$ref": "#/$defs/nonNegative" },
        "cachedInputTokens": { "$ref": "#/$defs/nonNegative" },
        "uncachedInputTokens": { "$ref": "#/$defs/nonNegative" },
        "reasoningTokens": { "$ref": "#/$defs/nonNegative" },
        "visibleOutputTokens": { "$ref": "#/$defs/nonNegative" },
        "completionTokens": { "$ref": "#/$defs/nonNegative" },
        "completionBudgetTokens": { "$ref": "#/$defs/nonNegative" },
        "completionHeadroomTokens": { "$ref": "#/$defs/nonNegative" },
        "completionUtilizationBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "cacheCoverageBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "sumPhaseLatencyMs": { "$ref": "#/$defs/nonNegative" },
        "elapsedLatencyMs": { "$ref": "#/$defs/nonNegative" }
      }
    },
    "proofLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveProviderQuality", "liveProviderPricing", "liveCacheAvailability"],
      "properties": {
        "liveProviderQuality": { "const": false },
        "liveProviderPricing": { "const": false },
        "liveCacheAvailability": { "const": false }
      }
    },
    "ledgerDigest": { "$ref": "#/$defs/digest" }
  }
}
