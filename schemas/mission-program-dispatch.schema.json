{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolId", "programId", "dispatchId", "stepId", "stepIndex", "kind", "inputDigest", "authorityCeilingDigest", "maxCompletionTokens", "maxResultBytes", "descriptorDigest", "dispatchDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-long-horizon-mission-program-v1" },
    "programId": { "$ref": "#/$defs/digest" },
    "dispatchId": { "$ref": "#/$defs/digest" },
    "stepId": { "$ref": "#/$defs/identifier" },
    "stepIndex": { "type": "integer", "minimum": 0, "maximum": 7 },
    "kind": { "$ref": "#/$defs/identifier" },
    "inputDigest": { "$ref": "#/$defs/digest" },
    "authorityCeilingDigest": { "$ref": "#/$defs/digest" },
    "maxCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 4000000 },
    "maxResultBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "descriptorDigest": { "$ref": "#/$defs/digest" },
    "dispatchDigest": { "$ref": "#/$defs/digest" }
  }
}
