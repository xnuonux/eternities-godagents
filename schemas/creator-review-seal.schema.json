{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogDigest", "draftDigest", "previewDigest", "sealDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogDigest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "draftDigest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "previewDigest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "sealDigest": { "type": "string", "minLength": 64, "maxLength": 64 }
  }
}
