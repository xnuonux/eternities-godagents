{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityExpanded", "realmEffects", "continuityAdmission", "personalKeelWrite", "identityOwnership", "evolution", "soul"],
      "properties": {
        "authorityExpanded": { "const": false },
        "realmEffects": { "const": false },
        "continuityAdmission": { "const": false },
        "personalKeelWrite": { "const": false },
        "identityOwnership": { "const": false },
        "evolution": { "const": false },
        "soul": { "const": false }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolId", "materializer", "mission", "admissionDigest", "requestDigest", "executorDescriptorDigest", "maxCompletionTokens", "maxArtifactBytes", "godskills", "authority", "packageDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-mission-native-package-v1" },
    "materializer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "protocolId", "maximumMaterializedBytes", "materializerDigest"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "protocolId": { "const": "eternities-mission-native-materializer-v1" },
        "maximumMaterializedBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 },
        "materializerDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missionId", "objective", "successEvidence", "stopConditions"],
      "properties": {
        "missionId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "successEvidence": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } },
        "stopConditions": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } }
      }
    },
    "admissionDigest": { "$ref": "#/$defs/digest" },
    "requestDigest": { "$ref": "#/$defs/digest" },
    "executorDescriptorDigest": { "$ref": "#/$defs/digest" },
    "maxCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "maxArtifactBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "godskills": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["bindingDigest", "packageDigest", "cortexPackage"],
          "properties": {
            "bindingDigest": { "$ref": "#/$defs/digest" },
            "packageDigest": { "$ref": "#/$defs/digest" },
            "cortexPackage": { "type": "object" }
          }
        }
      ]
    },
    "authority": { "$ref": "#/$defs/authority" },
    "packageDigest": { "$ref": "#/$defs/digest" }
  }
}
