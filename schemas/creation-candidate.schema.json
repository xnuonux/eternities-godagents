{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128 },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "identifierSet": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "textSet": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "blueprint", "genesis", "telos", "constitution", "promptOs", "memory", "moduleRefs", "expressionRef", "realm", "evolution", "soulPort"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "blueprint": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "$ref": "#/$defs/identifier" }, "version": { "$ref": "#/$defs/identifier" } }
    },
    "genesis": {
      "type": "object", "additionalProperties": false, "required": ["createdBy", "sourceManifest"],
      "properties": {
        "createdBy": { "$ref": "#/$defs/identifier" },
        "sourceManifest": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "telos": {
      "type": "object", "additionalProperties": false, "required": ["mission", "successConditions", "stopConditions"],
      "properties": {
        "mission": { "$ref": "#/$defs/text" },
        "successConditions": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "stopConditions": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "constitution": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "principles", "allowedEffects", "amendmentPolicy"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" }, "version": { "$ref": "#/$defs/identifier" },
        "principles": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "allowedEffects": { "$ref": "#/$defs/identifierSet" },
        "amendmentPolicy": { "const": "frozen-v0" }
      }
    },
    "promptOs": {
      "type": "object", "additionalProperties": false, "required": ["edition", "allowedAdapters", "requiredCapabilities"],
      "properties": {
        "edition": { "$ref": "#/$defs/identifier" },
        "allowedAdapters": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "requiredCapabilities": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false, "required": ["classes", "foreignHistoryPolicy"],
      "properties": {
        "classes": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "foreignHistoryPolicy": { "const": "provenance-only" }
      }
    },
    "moduleRefs": {
      "type": "object", "additionalProperties": false,
      "required": ["lineage", "archetype", "attributes", "personality", "voice", "organs", "godskills", "cortex", "embodiment"],
      "properties": {
        "lineage": { "$ref": "#/$defs/identifier" }, "archetype": { "$ref": "#/$defs/identifier" },
        "attributes": { "$ref": "#/$defs/identifier" }, "personality": { "$ref": "#/$defs/identifier" },
        "voice": { "$ref": "#/$defs/identifier" }, "organs": { "$ref": "#/$defs/identifier" },
        "godskills": { "$ref": "#/$defs/identifier" }, "cortex": { "$ref": "#/$defs/identifier" },
        "embodiment": { "$ref": "#/$defs/identifier" }
      }
    },
    "expressionRef": { "$ref": "#/$defs/identifier" },
    "realm": {
      "type": "object", "additionalProperties": false, "required": ["requiredCapabilities"],
      "properties": { "requiredCapabilities": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } } }
    },
    "evolution": { "type": "object", "additionalProperties": false, "required": ["policy"], "properties": { "policy": { "const": "frozen-v0" } } },
    "soulPort": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "status"],
      "properties": { "schemaVersion": { "const": 1 }, "status": { "const": "dormant" } }
    }
  }
}
