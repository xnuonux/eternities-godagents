{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "strings": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } },
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "mission", "observation", "requestedAuthority", "explicitMethodRequests", "hostCeiling", "budgets", "sourceStateEpoch", "maxCycles", "maxProjectionBytes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "hostAdapterId", "revocationEpoch"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "hostAdapterId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revocationEpoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missionId", "objective", "successEvidence", "stopConditions"],
      "properties": {
        "missionId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "successEvidence": { "$ref": "#/$defs/strings" },
        "stopConditions": { "$ref": "#/$defs/strings" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationId", "summary", "evidenceDigests"],
      "properties": {
        "observationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "evidenceDigests": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } }
      }
    },
    "requestedAuthority": { "$ref": "#/$defs/strings" },
    "explicitMethodRequests": { "$ref": "#/$defs/strings" },
    "hostCeiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availableAuthority", "permittedEffects", "availablePreconditions", "forbiddenCapabilities", "maximumRisk", "minimumEvidenceConfidence", "contextBudget", "maxCompositionSize"],
      "properties": {
        "availableAuthority": { "$ref": "#/$defs/strings" },
        "permittedEffects": { "$ref": "#/$defs/strings" },
        "availablePreconditions": { "$ref": "#/$defs/strings" },
        "forbiddenCapabilities": { "$ref": "#/$defs/strings" },
        "maximumRisk": { "enum": ["low", "moderate", "high"] },
        "minimumEvidenceConfidence": { "enum": ["unverified", "inferred", "verified"] },
        "contextBudget": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxCompositionSize": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxArtifactBytes", "nativeCompletionTokens", "reviewCompletionTokensPerRound", "revisionCompletionTokens", "totalCompletionTokens"],
      "properties": {
        "maxArtifactBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "nativeCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "reviewCompletionTokensPerRound": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "revisionCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "totalCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "sourceStateEpoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "maxCycles": { "type": "integer", "minimum": 1, "maximum": 32 },
    "maxProjectionBytes": { "type": "integer", "minimum": 256, "maximum": 1048576 }
  }
}
