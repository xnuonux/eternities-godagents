{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolId", "status", "active", "bindingId", "instanceId", "taskId", "revocationEpoch", "recordedAt", "registryEventDigest", "receiptDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-godagent-cortex-binding-registry-v1" },
    "status": { "enum": ["released", "revoked", "expired"] },
    "active": { "const": false },
    "bindingId": { "$ref": "#/$defs/digest" },
    "instanceId": { "$ref": "#/$defs/identifier" },
    "taskId": { "$ref": "#/$defs/identifier" },
    "revocationEpoch": { "type": "integer", "minimum": 0 },
    "recordedAt": { "type": "string", "minLength": 20, "maxLength": 32 },
    "registryEventDigest": { "$ref": "#/$defs/digest" },
    "receiptDigest": { "$ref": "#/$defs/digest" }
  }
}
