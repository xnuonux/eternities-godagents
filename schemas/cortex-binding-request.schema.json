{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128 },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "textSet": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "mission", "maxProjectionBytes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "hostAdapterId", "revocationEpoch"],
      "properties": {
        "taskId": { "$ref": "#/$defs/identifier" },
        "hostAdapterId": { "$ref": "#/$defs/identifier" },
        "revocationEpoch": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missionId", "objective", "successEvidence", "stopConditions", "budget", "observation"],
      "properties": {
        "missionId": { "$ref": "#/$defs/identifier" },
        "objective": { "$ref": "#/$defs/text" },
        "successEvidence": { "$ref": "#/$defs/textSet" },
        "stopConditions": { "$ref": "#/$defs/textSet" },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxCycles", "maxCompletionTokens"],
          "properties": {
            "maxCycles": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "maxCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 }
          }
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observationId", "summary", "evidenceDigests"],
          "properties": {
            "observationId": { "$ref": "#/$defs/identifier" },
            "summary": { "$ref": "#/$defs/text" },
            "evidenceDigests": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "maxProjectionBytes": { "type": "integer", "minimum": 256, "maximum": 1048576 }
  }
}
