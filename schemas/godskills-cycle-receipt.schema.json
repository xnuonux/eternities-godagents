{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolId", "requestId", "sourceEnvelopeDigest", "releaseDigest", "routerReceiptDigest", "selectionStatus", "selected", "authorityCeilingDigest", "stackDigest", "packageDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-godskills-adapter-v1" },
    "requestId": { "type": "string", "minLength": 1 },
    "sourceEnvelopeDigest": { "$ref": "#/$defs/digest" },
    "releaseDigest": { "$ref": "#/$defs/digest" },
    "routerReceiptDigest": { "$ref": "#/$defs/digest" },
    "selectionStatus": { "enum": ["selected", "no-qualified-route"] },
    "selected": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/selection" } },
    "authorityCeilingDigest": { "$ref": "#/$defs/digest" },
    "stackDigest": { "$ref": "#/$defs/digest" },
    "packageDigest": { "$ref": "#/$defs/digest" },
    "activation": { "$ref": "#/$defs/activation" },
    "preference": { "$ref": "#/$defs/preference" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entrypointSha256", "contractSha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "entrypointSha256": { "$ref": "#/$defs/digest" },
        "contractSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolId", "trustRootDigest", "suppliedIds", "qualifiedIds", "selectedIds", "baselineSelectedIds", "semanticCandidateIds", "applied", "reason", "preferenceDigest"],
      "properties": {
        "protocolId": { "const": "eternities-godskills-specialist-preference-v1" },
        "trustRootDigest": { "$ref": "#/$defs/digest" },
        "suppliedIds": { "$ref": "#/$defs/preferenceSet" },
        "qualifiedIds": { "$ref": "#/$defs/preferenceSet" },
        "selectedIds": { "$ref": "#/$defs/selectedIdSet" },
        "baselineSelectedIds": { "$ref": "#/$defs/selectedIdSet" },
        "semanticCandidateIds": { "$ref": "#/$defs/preferenceSet" },
        "applied": { "type": "boolean" },
        "reason": { "enum": ["equal-quality-tie-break", "selected-without-effect", "stronger-nonpreferred-selection", "preference-not-route-capable", "preference-not-semantic-candidate", "no-qualified-preference", "no-selection", "unresolved-decision"] },
        "preferenceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "protocolId", "requestId", "requestDigest", "trustRootDigest", "policyDigest", "evidenceDigest", "classification", "decisions", "resultDigest"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "protocolId": { "const": "eternities-godskills-activation-v1" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000\\r\\n]+$" },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "trustRootDigest": { "$ref": "#/$defs/digest" },
        "policyDigest": { "$ref": "#/$defs/digest" },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "classification": { "$ref": "#/$defs/classification" },
        "decisions": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/activationDecision" } },
        "resultDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskClass", "consequenceClass", "reviewAvailable"],
      "properties": {
        "taskClass": { "$ref": "#/$defs/taskClass" },
        "consequenceClass": { "$ref": "#/$defs/consequenceClass" },
        "reviewAvailable": { "type": "boolean" }
      }
    },
    "activationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "selectedId", "taskClass", "consequenceClass", "mode", "reasonCodes", "preInferenceDisclosure", "deferredReview", "methodEvidence", "policyDigest", "evidenceDigest", "authorityProjection", "authorityExpanded", "decisionDigest"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "selectedId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "taskClass": { "$ref": "#/$defs/taskClass" },
        "consequenceClass": { "$ref": "#/$defs/consequenceClass" },
        "mode": { "enum": ["native", "guardrail", "method", "review"] },
        "reasonCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "preInferenceDisclosure": { "enum": ["none", "guardrails-only", "entrypoint-and-contract"] },
        "deferredReview": { "type": "boolean" },
        "methodEvidence": { "$ref": "#/$defs/methodEvidence" },
        "policyDigest": { "$ref": "#/$defs/digest" },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "authorityProjection": { "$ref": "#/$defs/authorityProjection" },
        "authorityExpanded": { "const": false },
        "decisionDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "methodEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "matchedEvaluations", "wins", "losses", "ties", "winRate", "criticalRegressions", "overheadRatio", "failedGates"],
      "properties": {
        "eligible": { "type": "boolean" },
        "matchedEvaluations": { "type": "integer", "minimum": 0 },
        "wins": { "type": "integer", "minimum": 0 },
        "losses": { "type": "integer", "minimum": 0 },
        "ties": { "type": "integer", "minimum": 0 },
        "winRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "criticalRegressions": { "type": "integer", "minimum": 0 },
        "overheadRatio": { "oneOf": [{ "type": "null" }, { "type": "number", "exclusiveMinimum": 0 }] },
        "failedGates": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "authorityProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availableAuthority", "permittedEffects", "availablePreconditions", "maximumRisk", "minimumEvidenceConfidence", "contextBudget"],
      "properties": {
        "availableAuthority": { "$ref": "#/$defs/stringSet" },
        "permittedEffects": { "$ref": "#/$defs/stringSet" },
        "availablePreconditions": { "$ref": "#/$defs/stringSet" },
        "maximumRisk": { "enum": ["low", "moderate", "high"] },
        "minimumEvidenceConfidence": { "enum": ["unverified", "inferred", "verified"] },
        "contextBudget": { "type": "integer", "minimum": 0 }
      }
    },
    "stringSet": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "preferenceSet": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "selectedIdSet": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "taskClass": { "enum": ["creative-generation", "debugging-recovery", "implementation", "research", "continuity", "verification", "general"] },
    "consequenceClass": { "enum": ["low", "consequential", "critical"] }
  }
}
