{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolId", "status", "dispatchDigest", "transportReceiptDigest", "responseBytes", "responseDigest", "startedAt", "completedAt", "receiptDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-codex-task-execution-v1" },
    "status": { "const": "completed" },
    "dispatchDigest": { "$ref": "#/$defs/digest" },
    "transportReceiptDigest": { "$ref": "#/$defs/digest" },
    "responseBytes": { "type": "integer", "minimum": 0, "maximum": 4194304 },
    "responseDigest": { "$ref": "#/$defs/digest" },
    "startedAt": { "type": "string", "minLength": 20, "maxLength": 32 },
    "completedAt": { "type": "string", "minLength": 20, "maxLength": 32 },
    "receiptDigest": { "$ref": "#/$defs/digest" }
  }
}
