{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128 },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "identifierSet": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "pronouns", "genderPresentation", "voiceDisplayName", "narrativeDescription", "visual", "presentationTags", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" }, "version": { "$ref": "#/$defs/identifier" },
    "name": { "$ref": "#/$defs/identifier" },
    "pronouns": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "genderPresentation": { "$ref": "#/$defs/identifier" },
    "voiceDisplayName": { "$ref": "#/$defs/identifier" },
    "narrativeDescription": { "$ref": "#/$defs/text" },
    "visual": {
      "type": "object", "additionalProperties": false, "required": ["sigil", "colors", "avatarSeed", "animationProfile"],
      "properties": {
        "sigil": { "$ref": "#/$defs/identifier" },
        "colors": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "avatarSeed": { "$ref": "#/$defs/identifier" },
        "animationProfile": { "$ref": "#/$defs/identifier" }
      }
    },
    "presentationTags": { "$ref": "#/$defs/identifierSet" },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["author", "source"],
      "properties": { "author": { "$ref": "#/$defs/identifier" }, "source": { "$ref": "#/$defs/text" } }
    }
  }
}
