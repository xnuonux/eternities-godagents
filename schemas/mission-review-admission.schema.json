{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": { "digest": { "type": "string", "minLength": 64, "maxLength": 64 } },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolId", "mission", "authorityCeilingDigest", "budgets", "godskills", "admittedAt", "admissionDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-mission-review-kernel-v1" },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missionId", "objective", "successEvidence", "stopConditions"],
      "properties": {
        "missionId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "successEvidence": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } },
        "stopConditions": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } }
      }
    },
    "authorityCeilingDigest": { "$ref": "#/$defs/digest" },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nativeCompletionTokens", "reviewCompletionTokensPerRound", "revisionCompletionTokens", "totalCompletionTokens", "maxArtifactBytes"],
      "properties": {
        "nativeCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "reviewCompletionTokensPerRound": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "revisionCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "totalCompletionTokens": { "type": "integer", "minimum": 1, "maximum": 4000000 },
        "maxArtifactBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    },
    "godskills": {},
    "admittedAt": { "type": "string", "minLength": 24, "maxLength": 24 },
    "admissionDigest": { "$ref": "#/$defs/digest" }
  }
}
