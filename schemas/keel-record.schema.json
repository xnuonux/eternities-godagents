{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": { "digest": { "type": "string", "minLength": 64, "maxLength": 64 } },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "previousDigest", "kind", "payload", "contentDigest", "recordedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousDigest": { "$ref": "#/$defs/digest" },
    "kind": { "enum": ["bedrock", "constitution", "provenance", "soul-port", "checkpoint", "binding"] },
    "payload": { "type": "object", "additionalProperties": true },
    "contentDigest": { "$ref": "#/$defs/digest" },
    "recordedAt": { "type": "string", "minLength": 1, "maxLength": 64 }
  }
}
