{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityExpanded", "realmEffects", "continuityAdmission", "personalKeelWrite", "identityOwnership", "evolution", "soul"],
      "properties": {
        "authorityExpanded": { "const": false },
        "realmEffects": { "const": false },
        "continuityAdmission": { "const": false },
        "personalKeelWrite": { "const": false },
        "identityOwnership": { "const": false },
        "evolution": { "const": false },
        "soul": { "const": false }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolId", "status", "stage", "operationId", "dispatchDigest", "requestDigest", "transportDescriptorDigest", "result", "resultDigest", "startedAt", "completedAt", "authority", "completionDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-recoverable-godskills-completion-v1" },
    "status": { "const": "completed" },
    "stage": { "enum": ["route", "activation"] },
    "operationId": { "$ref": "#/$defs/digest" },
    "dispatchDigest": { "$ref": "#/$defs/digest" },
    "requestDigest": { "$ref": "#/$defs/digest" },
    "transportDescriptorDigest": { "$ref": "#/$defs/digest" },
    "result": { "type": "object" },
    "resultDigest": { "$ref": "#/$defs/digest" },
    "startedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "completedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "authority": { "$ref": "#/$defs/authority" },
    "completionDigest": { "$ref": "#/$defs/digest" }
  }
}
