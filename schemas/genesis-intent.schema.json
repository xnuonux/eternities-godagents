{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "instanceId", "creatorRef", "creationBuildId", "distributionBuildId", "policyDigest", "genomeValueDigest", "genomeContentDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "instanceId": { "$ref": "#/$defs/identifier" },
    "creatorRef": { "$ref": "#/$defs/identifier" },
    "creationBuildId": { "$ref": "#/$defs/digest" },
    "distributionBuildId": { "$ref": "#/$defs/digest" },
    "policyDigest": { "$ref": "#/$defs/digest" },
    "genomeValueDigest": { "$ref": "#/$defs/digest" },
    "genomeContentDigest": { "$ref": "#/$defs/digest" }
  }
}
