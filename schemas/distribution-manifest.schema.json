{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "type": "string", "minLength": 64 }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "buildId", "genomeDigest", "sources", "resolvedComponents", "omittedComponents", "compatibility", "artifacts", "validations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactId": { "type": "string", "minLength": 1 },
    "buildId": { "$ref": "#/$defs/digest" },
    "genomeDigest": { "$ref": "#/$defs/digest" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "resolvedComponents": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "omittedComponents": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cortexAdapters", "realmIds", "schemaRange"],
      "properties": {
        "cortexAdapters": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "realmIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "schemaRange": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail"] }
        }
      }
    }
  }
}
