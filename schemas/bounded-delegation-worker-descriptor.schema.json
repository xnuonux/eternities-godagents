{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolId", "adapterId", "version"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-bounded-delegation-worker-v1" },
    "adapterId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" }
  }
}
